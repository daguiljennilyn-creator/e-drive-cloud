# Leave VITE_API_URL unset to call the API on the same hostname as the app
# (http://<current-host>:8000/api). Set it only when the API lives elsewhere,
# and keep the hostname identical to the frontend so session cookies are sent.
# VITE_API_URL=http://127.0.0.1:8000/api

# Public origin of the frontend, used for share links and absolute URLs
VITE_APP_URL=http://127.0.0.1:5173
